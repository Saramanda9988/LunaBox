{
  "name": "LunaBox",
  "identifier": "io.github.saramanda9988.lunabox",
  "version": "2.0.0",
  "urlSchemes": ["lunabox"],
  "out": "build",
  "i18n": { "dir": "ui/locales", "source": "zh-CN" },
  "linux": { "webview": false },
  "macos": {
    "infoPlist": {
      "CFBundleGetInfoString": "LunaBox game library manager",
      "NSAudioCaptureUsageDescription": "LunaBox uses system audio access to mute games while they are in the background.",
      "NSHumanReadableCopyright": "Copyright (c) LunaBox contributors"
    }
  }
}
