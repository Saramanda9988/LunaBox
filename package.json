{
  "name": "lunabox-monorepo",
  "private": true,
  "scripts": {
    "setup": "pnpm -C apps/update-server install",
    "dev": "go -C apps/desktop run ./tools/mygo dev",
    "build": "go -C apps/desktop run ./tools/mygo build",
    "package": "go -C apps/desktop run ./tools/release",
    "i18n": "go -C apps/desktop run ./tools/mygo generate",
    "desktop:check": "go -C apps/desktop build ./...",
    "desktop:test": "go -C apps/desktop test -p 4 ./...",
    "backend:test": "go -C packages/backend test -p 4 ./...",
    "updater:test": "go -C packages/updater test ./...",
    "server:dev": "pnpm -C apps/update-server dev",
    "server:worker": "pnpm -C apps/update-server dev:worker",
    "server:check": "pnpm -C apps/update-server typecheck && pnpm -C apps/update-server test",
    "check": "pnpm desktop:check && pnpm updater:test && pnpm server:check"
  }
}
