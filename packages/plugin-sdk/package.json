{
  "name": "lunabox",
  "version": "1.0.0",
  "description": "LunaBox Plugin SDK, TypeScript types, JSX runtime, and CLI",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./jsx-runtime": {
      "types": "./src/jsx-runtime.ts",
      "default": "./src/jsx-runtime.ts"
    }
  },
  "bin": {
    "lunabox-plugin": "./bin/lunabox-plugin.mjs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0"
  }
}
