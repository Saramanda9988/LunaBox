{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "lunabox",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "lunabox": ["./src/index.ts"],
      "lunabox/jsx-runtime": ["./src/jsx-runtime.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
