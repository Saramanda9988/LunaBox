{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lunabox-update-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-17",
  "observability": {
    "enabled": true
  },

  "env": {
    "test": {
      "name": "lunabox-update-server-test",
      "workers_dev": true,
      "r2_buckets": [
        {
          "binding": "UPDATE_BUCKET",
          "bucket_name": "lunabox-updates-test"
        }
      ],
      "d1_databases": [
        {
          "binding": "UPDATE_DB",
          "database_name": "lunabox-updates-test",
          "database_id": "REPLACE_WITH_TEST_D1_DATABASE_ID",
          "migrations_dir": "migrations"
        }
      ]
    },
    "production": {
      "name": "lunabox-update-server",
      "workers_dev": true,
      "r2_buckets": [
        {
          "binding": "UPDATE_BUCKET",
          "bucket_name": "lunabox-updates"
        }
      ],
      "d1_databases": [
        {
          "binding": "UPDATE_DB",
          "database_name": "lunabox-updates",
          "database_id": "REPLACE_WITH_PRODUCTION_D1_DATABASE_ID",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
